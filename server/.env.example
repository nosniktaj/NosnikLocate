# ====================
# Server Configuration
# ====================
PORT=3000
NODE_ENV=production

# ====================
# PostgreSQL Database
# ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nosniklocate
DB_USER=nosniklocate_user
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ====================
# Redis
# ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ====================
# JWT Authentication
# ====================
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ====================
# Rate Limiting
# ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================
# CORS
# ====================
CORS_ORIGIN=*

# ====================
# Location Settings
# ====================
# Maximum distance in meters to consider friends "nearby"
NEARBY_DISTANCE_METERS=50000
# Maximum age of location data in minutes before it's considered stale
LOCATION_STALE_MINUTES=30

# ====================
# Email / SMTP
# ====================
# For Proton Mail Bridge SMTP: host=127.0.0.1, port=1025, secure=false
# (Port 1143 is for IMAP, not SMTP – use 1025 for sending mail)
# For other providers, adjust host/port accordingly
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=your-protonmail-address@protonmail.com
SMTP_PASS=your-proton-bridge-password
SMTP_FROM=NosnikLocate <noreply@nosniktaj.com>

# Set to 'true' to require email verification before login
EMAIL_VERIFICATION_ENABLED=true
